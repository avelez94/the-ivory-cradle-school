# PostgreSQL connection string (Neon, Supabase or any Postgres 13+)
DATABASE_URL=postgres://school:school@localhost:5432/ivory_school
# Public address of this site. Printed in certificate QR codes and verification links.
SITE_URL=http://localhost:3000
# staging labels every issued certificate "Sample". Set to production only at launch.
SCHOOL_ENVIRONMENT=staging
# Verification address printed on production credentials (defaults to SITE_URL)
VERIFY_BASE_URL=
# Private Vercel Blob store for staff video uploads (optional; linking a video URL works without it)
BLOB_READ_WRITE_TOKEN=
# Secret used to hash IP addresses for rate limiting
RATE_LIMIT_SALT=change-me
